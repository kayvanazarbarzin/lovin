{
  "name": "lavin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && pnpm lint:deps",
    "lint:deps": "depcruise apps services packages tools",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "audit:licenses": "node tools/license-gate/src/cli.ts",
    "audit:security": "pnpm audit --audit-level=high",
    "stack:up": "docker compose --env-file .env -f infra/compose/docker-compose.yml --profile core up -d --wait",
    "stack:down": "docker compose --env-file .env -f infra/compose/docker-compose.yml --profile core down",
    "db:migrate": "node --env-file=.env tools/db-migrate/src/cli.ts",
    "db:test-migrations": "pnpm --filter @lavin/db-migrate test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
