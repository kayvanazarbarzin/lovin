# Copy to .env and fill with LOCAL DEV values only. Never commit .env.
#   cp env.example .env
# Generate values with e.g.: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# (Named env.example, not .env.example, so agent read-deny rules on .env* stay strict.)

# PostgreSQL (one instance, one database + owner role each)
POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=
LAVIN_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
FLOWABLE_DB_PASSWORD=
CORTEZA_DB_PASSWORD=
PAYLOAD_DB_PASSWORD=

# Valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=

# NATS JetStream (user: lavin)
NATS_PORT=4222
NATS_PASSWORD=

# Keycloak bootstrap admin (first start only)
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
